<Window x:Class="NotificationTabApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeKeeper"
        Width="292" Height="48"
        MinWidth="200" MinHeight="40"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        StateChanged="Window_StateChanged">
    <Border x:Name="MainBorder"
            Background="#80222222"
            CornerRadius="8"
            MouseEnter="MainBorder_MouseEnter"
            MouseLeave="MainBorder_MouseLeave"
            MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
        <Grid Margin="6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ウィンドウ名 -->
            <TextBlock Grid.Column="0"
                       Text="TimeKeeper"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0"/>

            <!-- ピンマーク -->
            <Button Grid.Column="1"
                    x:Name="PinButton"
                    Content="📌"
                    Width="28" Height="28"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="White"
                    FontSize="13"
                    Padding="0"
                    Cursor="Hand"
                    ToolTip="常に最前面表示のON/OFF"
                    Click="PinButton_Click"/>

            <!-- 予定一覧マーク -->
            <Button Grid.Column="2"
                    x:Name="UpcomingButton"
                    Content="☰"
                    Width="28" Height="28"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="White"
                    FontSize="14"
                    Padding="0"
                    Cursor="Hand"
                    ToolTip="直近の予定一覧を開く"
                    Click="UpcomingButton_Click"/>

            <!-- プラスマーク -->
            <Button Grid.Column="3"
                    x:Name="AddButton"
                    Content="+"
                    Width="28" Height="28"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="White"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Padding="0"
                    Cursor="Hand"
                    ToolTip="通知または予定を追加する"
                    Click="AddButton_Click"/>

            <!-- 歯車マーク -->
            <Button Grid.Column="4"
                    x:Name="GearButton"
                    Content="⚙"
                    Width="28" Height="28"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="White"
                    FontSize="14"
                    Padding="0"
                    Cursor="Hand"
                    ToolTip="アプリ更新画面を開く"
                    Click="GearButton_Click"
                    Margin="0,0,2,0"/>
        </Grid>
    </Border>
</Window>
