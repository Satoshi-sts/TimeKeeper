<Window x:Class="NotificationTabApp.Views.NotificationListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登録通知一覧 - TimeKeeper"
        Width="560" Height="540"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="HeaderText"
                       Text="登録通知一覧"
                       FontSize="14"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    x:Name="DeleteModeButton"
                    Content="削除"
                    Width="76" Height="28"
                    FontSize="12"
                    Background="#E53935"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Cursor="Hand"
                    Click="DeleteModeButton_Click"/>
            <Button Grid.Column="2"
                    x:Name="CancelDeleteModeButton"
                    Content="キャンセル"
                    Width="80" Height="28"
                    FontSize="12"
                    Background="#757575"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Click="CancelDeleteModeButton_Click"
                    Margin="8,0,0,0"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="検索"
                       FontSize="12"
                       Foreground="#555"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox Grid.Column="1"
                     x:Name="SearchBox"
                     Height="28"
                     FontSize="12"
                     Padding="8,4"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"/>
            <Button Grid.Column="2"
                    x:Name="ClearSearchButton"
                    Content="クリア"
                    Width="60" Height="28"
                    FontSize="12"
                    Background="#EEEEEE"
                    BorderBrush="#CCCCCC"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Click="ClearSearchButton_Click"
                    Margin="8,0,0,0"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GroupList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="{Binding IsExpanded}"
                                  Margin="0,0,0,8"
                                  Background="Transparent">
                            <Expander.Header>
                                <Grid Width="500">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Visibility="{Binding GroupToggleVisibility}"
                                              IsEnabled="{Binding IsGroupToggleEnabled}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              Checked="GroupEnabledCheckBox_Changed"
                                              Unchecked="GroupEnabledCheckBox_Changed"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#222"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Summary}"
                                               FontSize="11"
                                               Foreground="#777"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Expander.Header>

                            <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding ItemBackground}"
                                                BorderBrush="{Binding ItemBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Margin="0,0,0,6"
                                                Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0"
                                                          Foreground="{Binding CheckBrush}"
                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                          Checked="ItemCheckBox_Changed"
                                                          Unchecked="ItemCheckBox_Changed"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding CheckLabel}"
                                                           Foreground="{Binding CheckBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0"/>

                                                <StackPanel Grid.Column="2"
                                                            Cursor="Hand"
                                                            MouseLeftButtonDown="ItemContent_Click">
                                                    <TextBlock Text="{Binding DisplayTitle}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#222"/>
                                                    <TextBlock Text="{Binding TimeRange}"
                                                               FontSize="11"
                                                               Foreground="#888"
                                                               Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding MessagePreview}"
                                                               FontSize="11"
                                                               Foreground="#555"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="InfoText"
                   Grid.Row="3"
                   Foreground="#555"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="Collapsed"/>
    </Grid>
</Window>
