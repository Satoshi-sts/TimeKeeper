<Window x:Class="NotificationTabApp.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アプリ更新 - TimeKeeper"
        Width="500" Height="520"
        MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="アプリ更新"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#222"
                   Margin="0,0,0,14"/>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="現在のバージョン"
                           FontSize="12"
                           Foreground="#666"
                           Margin="0,0,12,8"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           x:Name="CurrentVersionText"
                           FontSize="13"
                           Foreground="#222"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="最新バージョン"
                           FontSize="12"
                           Foreground="#666"
                           Margin="0,0,12,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           x:Name="LatestVersionText"
                           FontSize="13"
                           Foreground="#222"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   x:Name="StatusText"
                   Text="更新確認を実行できます。"
                   Foreground="#444"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <ProgressBar Grid.Row="3"
                     x:Name="DownloadProgress"
                     Height="8"
                     Minimum="0"
                     Maximum="100"
                     Visibility="Collapsed"
                     Margin="0,0,0,12"/>

        <GroupBox Grid.Row="4"
                  Header="更新内容"
                  Foreground="#333"
                  Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="8">
                <TextBlock x:Name="ReleaseNotesText"
                           Text="更新確認後に表示されます。"
                           FontSize="12"
                           Foreground="#444"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </GroupBox>

        <TextBlock Grid.Row="5"
                   x:Name="ErrorText"
                   Foreground="#C62828"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    x:Name="CheckButton"
                    Content="更新を確認"
                    Width="104" Height="32"
                    Background="#1976D2"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Cursor="Hand"
                    Click="CheckButton_Click"
                    Margin="0,0,8,0"/>

            <Button Grid.Column="2"
                    x:Name="UpdateButton"
                    Content="更新する"
                    Width="92" Height="32"
                    Background="#2E7D32"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Cursor="Hand"
                    IsEnabled="False"
                    Click="UpdateButton_Click"
                    Margin="0,0,8,0"/>

            <Button Grid.Column="3"
                    Content="閉じる"
                    Width="76" Height="32"
                    Background="#757575"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Cursor="Hand"
                    Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
