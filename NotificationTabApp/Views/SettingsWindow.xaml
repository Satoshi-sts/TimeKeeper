<Window x:Class="NotificationTabApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定 - TimeKeeper"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="タイトル" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
            <TextBox x:Name="TitleBox"
                     Height="28"
                     Padding="6,4"
                     FontSize="13"
                     BorderBrush="#CCC"
                     BorderThickness="1"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="グループ" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          x:Name="GroupBox"
                          Height="28"
                          FontSize="13"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"/>
                <TextBox Grid.Column="1"
                         x:Name="NewGroupNameBox"
                         Height="28"
                         Padding="6,4"
                         FontSize="13"
                         BorderBrush="#CCC"
                         BorderThickness="1"
                         Margin="8,0,8,0"/>
                <Button Grid.Column="2"
                        Content="追加"
                        Width="56" Height="28"
                        FontSize="12"
                        Background="#607D8B"
                        Foreground="White"
                        BorderBrush="Transparent"
                        Cursor="Hand"
                        Click="AddGroupButton_Click"/>
            </Grid>
        </StackPanel>

        <CheckBox Grid.Row="2"
                  x:Name="OneTimeCheckBox"
                  Content="一度限りの予定"
                  FontSize="13"
                  Foreground="#333"
                  Margin="0,0,0,12"/>

        <CheckBox Grid.Row="3"
                  x:Name="EorzeaTimeCheckBox"
                  Content="エオルゼア時間"
                  FontSize="13"
                  Foreground="#333"
                  Margin="0,0,0,12"/>

        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="通知開始時間" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
            <ComboBox x:Name="StartTimeBox"
                      Height="28"
                      Width="100"
                      HorizontalAlignment="Left"
                      FontSize="13"
                      IsEditable="False"
                      SelectionChanged="StartTimeBox_SelectionChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,12">
            <TextBlock Text="通知終了時間" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
            <ComboBox x:Name="EndTimeBox"
                      Height="28"
                      Width="100"
                      HorizontalAlignment="Left"
                      FontSize="13"
                      IsEditable="False"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,0,0,16">
            <TextBlock Text="表示文字" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
            <TextBox x:Name="MessageBox"
                     Height="80"
                     Padding="6,4"
                     FontSize="13"
                     BorderBrush="#CCC"
                     BorderThickness="1"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="7"
                   Foreground="Red"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="Collapsed"/>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="登録通知一覧"
                    Width="110" Height="30"
                    FontSize="12"
                    Background="#607D8B"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Cursor="Hand"
                    Click="NotificationListButton_Click"/>

            <Button Grid.Column="2"
                    Content="保存"
                    Width="80" Height="30"
                    FontSize="12"
                    Background="#1976D2"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Cursor="Hand"
                    Click="SaveButton_Click"
                    Margin="0,0,8,0"/>

            <Button Grid.Column="3"
                    Content="キャンセル"
                    Width="80" Height="30"
                    FontSize="12"
                    Background="#757575"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Cursor="Hand"
                    Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>
